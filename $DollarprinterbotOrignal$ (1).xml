<?xml version="1.0" encoding="utf-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable id="stake">stake</variable>
    <variable id="prediction">prediction</variable>
  </variables>
  <block type="bot_start" x="10" y="10">
    <next>
      <block type="variables_set">
        <field name="VAR">stake</field>
        <value name="VALUE">
          <block type="math_number">
            <field name="NUM">0.35</field>
          </block>
        </value>
        <next>
          <block type="variables_set">
            <field name="VAR">prediction</field>
            <value name="VALUE">
              <block type="math_number">
                <field name="NUM">7</field>
              </block>
            </value>
            <next>
              <block type="controls_whileUntil">
                <field name="MODE">WHILE</field>
                <value name="BOOL">
                  <block type="logic_boolean">
                    <field name="BOOL">TRUE</field>
                  </block>
                </value>
                <statement name="DO">
                  <block type="trade_definition_tradeoptions">
                    <field name="TRADETYPE">DIGITDIFF</field>
                    <field name="DURATIONTYPE">tick</field>
                    <field name="DURATION">1</field>
                    <value name="SYMBOL">
                      <block type="text">
                        <field name="TEXT">R_100</field>
                      </block>
                    </value>
                    <value name="PREDICTION">
                      <block type="variables_get">
                        <field name="VAR">prediction</field>
                      </block>
                    </value>
                    <value name="SIZE">
                      <block type="variables_get">
                        <field name="VAR">stake</field>
                      </block>
                    </value>
                    <next>
                      <block type="trade_definition_restart_on_error">
                        <next>
                          <block type="trade_definition_conditions">
                            <statement name="AFTER_PURCHASE">
                              <block type="controls_if">
                                <value name="IF0">
                                  <block type="logic_compare">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="get_purchase_info">
                                        <field name="FIELD">result</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="text">
                                        <field name="TEXT">win</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="text_print">
                                    <value name="TEXT">
                                      <block type="text">
                                        <field name="TEXT">WIN!</field>
                                      </block>
                                    </value>
                                  </block>
                                </statement>
                                <else>
                                  <block type="text_print">
                                    <value name="TEXT">
                                      <block type="text">
                                        <field name="TEXT">LOST</field>
                                      </block>
                                    </value>
                                  </block>
                                </else>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
